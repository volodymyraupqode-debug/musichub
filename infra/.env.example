# Host ports for infra/docker-compose.yml. Copy to infra/.env to override.
# 54320 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=54320
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_PORT=8333
# Local-only S3 credentials for SeaweedFS (never reuse elsewhere).
S3_ACCESS_KEY_ID=musichub
S3_SECRET_ACCESS_KEY=musichub-secret
S3_BUCKET=musichub-local
