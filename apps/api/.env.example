APP_NAME=MusicHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL from infra/docker-compose.yml (host port POSTGRES_PORT, default 54320)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=musichub
DB_USERNAME=musichub
DB_PASSWORD=musichub

# Redis from infra/docker-compose.yml; cache, queue and sessions use Redis (ARCHITECTURE.md §2)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# MinIO (S3-compatible) from infra/docker-compose.yml — local development only
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=musichub
AWS_SECRET_ACCESS_KEY=musichub-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=musichub-local
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/musichub-local
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mailpit from infra/docker-compose.yml (UI on http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@musichub.test"
MAIL_FROM_NAME="${APP_NAME}"
