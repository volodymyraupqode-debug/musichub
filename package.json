{
  "name": "musichub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "codegen": "turbo run codegen",
    "depcruise": "depcruise apps packages spikes --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@musichub/config": "workspace:*",
    "dependency-cruiser": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
