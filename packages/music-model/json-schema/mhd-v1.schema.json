{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MhdDocument",
  "$defs": {
    "MhdDocument": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "musichub"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/DocumentId"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "masterBars": {
          "minItems": 1,
          "maxItems": 5000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/MasterBar"
          }
        },
        "tracks": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Track"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "id",
        "meta",
        "masterBars",
        "tracks"
      ],
      "additionalProperties": false,
      "title": "MusicHub Document (MHD) v1"
    },
    "DocumentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "album": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "composer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lyricist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "transcriber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "copyright": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "MasterBar": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "timeSignature": {
          "$ref": "#/$defs/TimeSignature"
        },
        "keySignature": {
          "$ref": "#/$defs/KeySignature"
        },
        "tempoChanges": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TempoChange"
          }
        },
        "tripletFeel": {
          "type": "string",
          "enum": [
            "none",
            "8th",
            "16th",
            "dotted8th",
            "dotted16th",
            "scottish8th",
            "scottish16th"
          ]
        },
        "repeatStart": {
          "type": "boolean",
          "const": true
        },
        "repeatEnd": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 99
            }
          },
          "required": [
            "count"
          ],
          "additionalProperties": false
        },
        "alternateEndings": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "section": {
          "type": "object",
          "properties": {
            "letter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "direction": {
          "type": "string",
          "enum": [
            "segno",
            "segnoSegno",
            "coda",
            "doubleCoda",
            "fine",
            "daCapo",
            "daCapoAlFine",
            "daCapoAlCoda",
            "dalSegno",
            "dalSegnoAlFine",
            "dalSegnoAlCoda",
            "toCoda"
          ]
        },
        "fermatas": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fermata"
          }
        },
        "isAnacrusis": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "MhdId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{12}$"
    },
    "TimeSignature": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "denominator": {
          "type": "number",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "KeySignature": {
      "type": "object",
      "properties": {
        "fifths": {
          "type": "integer",
          "minimum": -7,
          "maximum": 7
        },
        "mode": {
          "type": "string",
          "enum": [
            "major",
            "minor"
          ]
        }
      },
      "required": [
        "fifths",
        "mode"
      ],
      "additionalProperties": false
    },
    "TempoChange": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/Position"
        },
        "bpm": {
          "type": "number",
          "minimum": 20,
          "maximum": 400
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "position",
        "bpm"
      ],
      "additionalProperties": false
    },
    "Position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "Fermata": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/Position"
        },
        "type": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ]
        }
      },
      "required": [
        "position"
      ],
      "additionalProperties": false
    },
    "Track": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "color": {
          "type": "string",
          "enum": [
            "track.1",
            "track.2",
            "track.3",
            "track.4",
            "track.5",
            "track.6",
            "track.7",
            "track.8",
            "track.9",
            "track.10",
            "track.11",
            "track.12"
          ]
        },
        "instrument": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "enum": [
                "guitar",
                "bass",
                "piano",
                "drums",
                "vocals",
                "strings",
                "brass",
                "woodwinds",
                "synth",
                "other"
              ]
            },
            "midiProgram": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "bank": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16383
            },
            "percussion": {
              "type": "boolean"
            }
          },
          "required": [
            "family",
            "midiProgram",
            "percussion"
          ],
          "additionalProperties": false
        },
        "mixer": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pan": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "mute": {
              "type": "boolean"
            },
            "solo": {
              "type": "boolean"
            }
          },
          "required": [
            "volume",
            "pan",
            "mute",
            "solo"
          ],
          "additionalProperties": false
        },
        "staves": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Staff"
          }
        },
        "slurs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slur"
          }
        }
      },
      "required": [
        "id",
        "name",
        "color",
        "instrument",
        "mixer",
        "staves"
      ],
      "additionalProperties": false
    },
    "Staff": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "display": {
          "type": "object",
          "properties": {
            "standard": {
              "type": "boolean"
            },
            "tab": {
              "type": "boolean"
            },
            "slash": {
              "type": "boolean"
            },
            "numbered": {
              "type": "boolean"
            }
          },
          "required": [
            "standard",
            "tab",
            "slash",
            "numbered"
          ],
          "additionalProperties": false
        },
        "stringed": {
          "type": "object",
          "properties": {
            "tuning": {
              "minItems": 4,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              }
            },
            "capo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            },
            "fretCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36
            }
          },
          "required": [
            "tuning",
            "capo",
            "fretCount"
          ],
          "additionalProperties": false
        },
        "transpositionPitch": {
          "type": "integer",
          "minimum": -48,
          "maximum": 48
        },
        "hand": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "bars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bar"
          }
        }
      },
      "required": [
        "id",
        "display",
        "bars"
      ],
      "additionalProperties": false
    },
    "Bar": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "clef": {
          "type": "string",
          "enum": [
            "G2",
            "F4",
            "C3",
            "C4",
            "neutral"
          ]
        },
        "ottava": {
          "type": "string",
          "enum": [
            "15ma",
            "8va",
            "8vb",
            "15mb"
          ]
        },
        "sustainPedal": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SustainPedal"
          }
        },
        "voices": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Voice"
          }
        }
      },
      "required": [
        "id",
        "voices"
      ],
      "additionalProperties": false
    },
    "SustainPedal": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/Position"
        },
        "type": {
          "type": "string",
          "enum": [
            "down",
            "up"
          ]
        }
      },
      "required": [
        "position",
        "type"
      ],
      "additionalProperties": false
    },
    "Voice": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Beat"
          }
        }
      },
      "required": [
        "id",
        "beats"
      ],
      "additionalProperties": false
    },
    "Beat": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "duration": {
          "$ref": "#/$defs/Duration"
        },
        "rest": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Note"
          }
        },
        "grace": {
          "type": "string",
          "enum": [
            "beforeBeat",
            "onBeat"
          ]
        },
        "dynamic": {
          "type": "string",
          "enum": [
            "ppp",
            "pp",
            "p",
            "mp",
            "mf",
            "f",
            "ff",
            "fff"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lyrics": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "effects": {
          "$ref": "#/$defs/BeatEffects"
        }
      },
      "required": [
        "id",
        "duration",
        "rest",
        "notes"
      ],
      "additionalProperties": false
    },
    "Duration": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32,
            64,
            128
          ]
        },
        "dots": {
          "type": "number",
          "enum": [
            0,
            1,
            2
          ]
        },
        "tuplet": {
          "type": "object",
          "properties": {
            "actual": {
              "type": "integer",
              "minimum": 2,
              "maximum": 15
            },
            "normal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            }
          },
          "required": [
            "actual",
            "normal"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "value",
        "dots"
      ],
      "additionalProperties": false
    },
    "Note": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "string": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "fret": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "pitch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "spelling": {
          "type": "object",
          "properties": {
            "step": {
              "type": "string",
              "enum": [
                "C",
                "D",
                "E",
                "F",
                "G",
                "A",
                "B"
              ]
            },
            "alter": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            }
          },
          "required": [
            "step",
            "alter"
          ],
          "additionalProperties": false
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "hand": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "tiedFromPrevious": {
          "type": "boolean",
          "const": true
        },
        "drumTechnique": {
          "type": "string",
          "enum": [
            "halfOpen",
            "rimshot",
            "edge",
            "choke"
          ]
        },
        "effects": {
          "$ref": "#/$defs/NoteEffects"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "NoteEffects": {
      "type": "object",
      "properties": {
        "bend": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/BendPoint"
          }
        },
        "slideOut": {
          "type": "string",
          "enum": [
            "shift",
            "legato",
            "outUp",
            "outDown"
          ]
        },
        "slideIn": {
          "type": "string",
          "enum": [
            "intoFromBelow",
            "intoFromAbove"
          ]
        },
        "hammerPullOrigin": {
          "type": "boolean",
          "const": true
        },
        "palmMute": {
          "type": "boolean",
          "const": true
        },
        "letRing": {
          "type": "boolean",
          "const": true
        },
        "deadNote": {
          "type": "boolean",
          "const": true
        },
        "ghost": {
          "type": "boolean",
          "const": true
        },
        "staccato": {
          "type": "boolean",
          "const": true
        },
        "accent": {
          "type": "string",
          "enum": [
            "normal",
            "heavy"
          ]
        },
        "tenuto": {
          "type": "boolean",
          "const": true
        },
        "harmonic": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "natural",
                "artificial",
                "pinch",
                "tap",
                "semi",
                "feedback"
              ]
            },
            "fret": {
              "type": "number",
              "minimum": 0,
              "maximum": 36
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "vibrato": {
          "type": "string",
          "enum": [
            "slight",
            "wide"
          ]
        },
        "trill": {
          "type": "object",
          "properties": {
            "fret": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            },
            "speed": {
              "type": "number",
              "enum": [
                16,
                32,
                64
              ]
            }
          },
          "required": [
            "fret",
            "speed"
          ],
          "additionalProperties": false
        },
        "fingering": {
          "type": "object",
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "right": {
              "type": "string",
              "enum": [
                "p",
                "i",
                "m",
                "a",
                "c"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "BendPoint": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "value": {
          "type": "integer",
          "minimum": -24,
          "maximum": 24
        }
      },
      "required": [
        "offset",
        "value"
      ],
      "additionalProperties": false
    },
    "BeatEffects": {
      "type": "object",
      "properties": {
        "vibrato": {
          "type": "string",
          "enum": [
            "slight",
            "wide"
          ]
        },
        "tremoloPicking": {
          "type": "number",
          "enum": [
            8,
            16,
            32
          ]
        },
        "pickStroke": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "brush": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "duration": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "direction"
          ],
          "additionalProperties": false
        },
        "tap": {
          "type": "boolean",
          "const": true
        },
        "slap": {
          "type": "boolean",
          "const": true
        },
        "pop": {
          "type": "boolean",
          "const": true
        },
        "fadeIn": {
          "type": "boolean",
          "const": true
        },
        "whammy": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/BendPoint"
          }
        },
        "crescendo": {
          "type": "string",
          "enum": [
            "crescendo",
            "decrescendo"
          ]
        }
      },
      "additionalProperties": false
    },
    "Slur": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MhdId"
        },
        "from": {
          "$ref": "#/$defs/MhdId"
        },
        "to": {
          "$ref": "#/$defs/MhdId"
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "JsonValue": {
      "$ref": "#/$defs/__schema0"
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
